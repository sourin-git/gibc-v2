{
  "run_name": "smoke",
  "placeholder": false,
  "notes": "Correctness smoke run only (pipeline, accumulation, validation, checkpoint, resume). Values are NOT candidate production hyperparameters.",
  "model_config": "configs/model/gibc_43m.json",
  "tokens": "pilot",
  "seq_len": 128,
  "micro_batch_size": 4,
  "grad_accum_steps": 2,
  "max_steps": 60,
  "precision": "bf16",
  "lr": 0.001,
  "min_lr_ratio": 0.1,
  "warmup_steps": 10,
  "weight_decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-08,
  "grad_clip": 1.0,
  "seed": 1234,
  "log_every": 5,
  "eval_every": 20,
  "eval_batches": 8,
  "checkpoint_every_steps": 20,
  "checkpoint_every_minutes": 0,
  "keep_checkpoints": 3,
  "allow_tf32": true,
  "fused_adamw": true,
  "device": "cuda"
}
